<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.co.kc.im</groupId>
        <artifactId>im-chat</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>im-architecture</artifactId>
    <name>IM Architecture</name>

    <dependencies>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-broker-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-http-gateway</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-ws-gateway-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-account-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-social-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-message-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-monitor</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-admin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-iam-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-audit-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-audit-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-broker-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-ws-gateway-sdk</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-account-facade</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-account-admin-facade</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-social-facade</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.co.kc.im</groupId>
            <artifactId>im-message-facade</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <additionalClasspathElements>
                        <!-- Spring Boot repackages executable application classes under BOOT-INF. -->
                        <additionalClasspathElement>
                            ${maven.multiModuleProjectDirectory}/im-management/im-admin/target/classes
                        </additionalClasspathElement>
                        <additionalClasspathElement>
                            ${maven.multiModuleProjectDirectory}/im-management/im-audit/im-audit-server/target/classes
                        </additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
