{
  "version": 1,
  "levels": {
    "connection": [50, 100, 200, 400, 800, 1600, 3200],
    "message": [50, 100, 200, 400, 800, 1600, 3200]
  },
  "messageMix": {
    "private": 70,
    "group": 30
  },
  "groupSize": 10,
  "messageBytes": 256,
  "repetitions": 3,
  "windows": {
    "warmupSeconds": 60,
    "measureSeconds": 300,
    "drainSeconds": 60
  },
  "phases": [
    {"id": "steady-state", "fault": "none"},
    {"id": "gateway-switch", "fault": "replace-one-gateway"},
    {"id": "broker-drain", "fault": "drain-route-broker"},
    {"id": "leader-route-broker-failure", "fault": "stop-leader-and-route-broker"},
    {"id": "minority-jvm-pause", "fault": "pause-minority-voters"}
  ],
  "candidateTopologies": [
    {"id": "three-voter", "voters": 3, "brokers": 3, "gateways": 2},
    {"id": "five-voter", "voters": 5, "brokers": 5, "gateways": 3}
  ],
  "resourceHeadroomPercent": 30,
  "thresholds": {
    "connectionSuccessRateMin": 0.995,
    "businessSuccessRateMin": 0.999,
    "ackSuccessRateMin": 0.999,
    "receiveLatencyP95MsMax": 500,
    "receiveLatencyP99MsMax": 2000,
    "duplicateRateMax": 0.001,
    "misrouteCountMax": 0,
    "oldEpochAdmissionCountMax": 0,
    "routeLookupP95MsMax": 300,
    "routeLookupP99MsMax": 2000,
    "fullLookupRateMax": 0.001,
    "snapshotAckRateMin": 1.0,
    "staleRouteCountMax": 0,
    "cpuLimitPercentMax": 70,
    "rssLimitPercentMax": 70,
    "diskUsagePercentMax": 70
  }
}
