<?xml version="1.0" encoding="UTF-8"?>
<included>
    <conversionRule conversionWord="tid"
                    class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.LogbackPatternConverter"/>

    <property name="FILE_LOG_PATTERN"
              value="${IM_LOG_PATTERN:-%d{yyyy-MM-dd HH:mm:ss.SSS} [%tid] [%X{traceId}] %-5level [%thread] %logger{36} - %msg%n}"/>

    <appender name="IM_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">
                <pattern>${FILE_LOG_PATTERN}</pattern>
            </layout>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
</included>
