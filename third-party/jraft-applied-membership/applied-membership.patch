+
+        assertTrue(this.fsmCaller.onCommitted(3));
+        final AppliedConfiguration after = read();
+        assertEquals(3, after.getAppliedIndex());
+        assertEquals(3, after.getConfigurationAnchor());
+        assertTrue(after.isStable());
+        assertEquals(Collections.singleton(address(18009)), after.getVoters());
+        assertTrue(after.getOldVoters().isEmpty());
+        assertTrue(after.getOldLearners().isEmpty());
+        assertJoint(before, 2, 2, 18001);
