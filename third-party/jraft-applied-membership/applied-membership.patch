+package com.alipay.sofa.jraft.conf;
+
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.Set;
+
+import com.alipay.sofa.jraft.entity.PeerId;
+
+/**
+ * Immutable membership at a local FSM application ordering point. Peer values
+ * retain the canonical PeerId identity without exposing mutable PeerId objects.
+ */
+public final class AppliedConfiguration {
+    private final long        appliedIndex;
+    private final long        configurationAnchor;
+    private final Set<String> voters;
+    private final Set<String> learners;
+    private final Set<String> oldVoters;
+    private final Set<String> oldLearners;
+    private final boolean     stable;
+
+    public AppliedConfiguration(final long appliedIndex, final ConfigurationEntry entry) {
+        this.appliedIndex = appliedIndex;
+        this.configurationAnchor = entry.getId().getIndex();
+        this.voters = copy(entry.getConf());
+        this.learners = copy(entry.getConf().getLearners());
+        this.oldVoters = copy(entry.getOldConf());
+        this.oldLearners = copy(entry.getOldConf().getLearners());
+        this.stable = entry.isStable();
+    }
+
+    public long getAppliedIndex() {
+        return this.appliedIndex;
+    }
+
+    /** Latest configuration entry or snapshot anchor, NOT the original change index. */
+    public long getConfigurationAnchor() {
+        return this.configurationAnchor;
+    }
+
+    public Set<String> getVoters() {
+        return this.voters;
+    }
+
+    public Set<String> getLearners() {
+        return this.learners;
+    }
+
+    public Set<String> getOldVoters() {
+        return this.oldVoters;
+    }
+
+    public Set<String> getOldLearners() {
+        return this.oldLearners;
+    }
+
+    public boolean isStable() {
+        return this.stable;
+    }
+
+    private static Set<String> copy(final Iterable<PeerId> peers) {
+        final Set<String> values = new LinkedHashSet<>();
+        for (final PeerId peer : peers) {
+            values.add(peer.toString());
+        }
+        return Collections.unmodifiableSet(values);
+    }
+}
