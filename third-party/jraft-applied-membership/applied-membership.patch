+    @Test
+    public void testConflictingUncommittedSuffixDoesNotReplaceAppliedJointConfiguration() throws Exception {
+        final AppliedConfiguration before = applyJointWithUncommittedStable();
+        append(configuration(4, 1, false, 18011));
+        assertEquals(4, this.logManager.getConfiguration(4).getId().getIndex());
+        // Follower receives a higher-term replacement at 3; real append conflict handling truncates 3 and 4.
+        append(noop(3, 2));
+        assertEquals(3, this.logManager.getLastLogIndex(true));
+        assertEquals(2, this.logManager.getTerm(3));
+        assertNull(this.logManager.getEntry(4));
+        assertEquals(2, this.logManager.getConfiguration(4).getId().getIndex());
+        assertJoint(read(), 2, 2, 18001);
+        assertTrue(this.fsmCaller.onCommitted(3));
+        assertJoint(read(), 3, 2, 18001);
+        assertJoint(before, 2, 2, 18001);
+    }
+
+    private AppliedConfiguration applyJointWithUncommittedStable() throws Exception {
+        append(configuration(1, 1, false, 18001), configuration(2, 1, true, 18001), configuration(3, 1, false, 18009));
+        assertTrue(this.fsmCaller.onCommitted(2));
+        return read();
+    }
+
+    private AppliedConfiguration read() throws Exception {
+        return this.fsmCaller.getAppliedConfiguration(TimeUnit.SECONDS.toMillis(TIMEOUT_SECONDS));
+    }
+
+    private void append(final LogEntry... entries) throws Exception {
+        final CompletableFuture<Status> appended = new CompletableFuture<>();
+        this.logManager.appendEntries(new ArrayList<>(Arrays.asList(entries)), new LogManager.StableClosure() {
+            @Override
+            public void run(final Status status) {
+                appended.complete(status);
+            }
+        });
+        final Status status = appended.get(TIMEOUT_SECONDS, TimeUnit.SECONDS);
+        assertTrue(status.toString(), status.isOk());
+    }
+
+    private CompletableFuture<Status> load(final SnapshotMeta meta) {
+        final SnapshotReader reader = mock(SnapshotReader.class);
+        when(reader.load()).thenReturn(meta);
+        final CompletableFuture<Status> loaded = new CompletableFuture<>();
+        assertTrue(this.fsmCaller.onSnapshotLoad(new LoadSnapshotClosure() {
+            @Override
+            public SnapshotReader start() {
+                return reader;
+            }
+
+            @Override
+            public void run(final Status status) {
+                if (status.isOk()) {
+                    installEntered.countDown();
+                    await(allowInstall);
+                    // Same synchronous ordering as SnapshotExecutorImpl's install-done closure.
+                    logManager.setSnapshot(meta);
+                }
+                loaded.complete(status);
+            }
+        }));
+        return loaded;
+    }
+
+    private void assertReadUnavailable() throws Exception {
+        try {
+            read();
+            fail("A failed snapshot load must not supply usable membership");
+        } catch (final IllegalStateException expected) {
+            assertNotNull(expected.getCause());
+        }
+    }
+
+    private static void assertPending(final Future<?> future) throws Exception {
+        try {
+            future.get(100, TimeUnit.MILLISECONDS);
+            fail("Read returned while the snapshot event was still blocked");
+        } catch (final TimeoutException expected) {
+            assertFalse(future.isDone());
+        }
+    }
+
+    private static void await(final CountDownLatch latch) {
+        try {
+            assertTrue("Timed out waiting for fixture boundary", latch.await(TIMEOUT_SECONDS, TimeUnit.SECONDS));
+        } catch (final InterruptedException interrupted) {
+            Thread.currentThread().interrupt();
+            throw new AssertionError(interrupted);
+        }
+    }
+
+    private static void assertJoint(final AppliedConfiguration value, final long applied, final long anchor,
+                                    final int basePort) {
+        assertEquals(applied, value.getAppliedIndex());
+        assertEquals(anchor, value.getConfigurationAnchor());
+        assertFalse(value.isStable());
+        assertEquals(Collections.singleton(address(basePort)), value.getVoters());
+        assertEquals(Collections.singleton(address(basePort + 1)), value.getLearners());
+        assertEquals(Collections.singleton(address(basePort + 2)), value.getOldVoters());
+        assertEquals(Collections.singleton(address(basePort + 3)), value.getOldLearners());
+    }
+
+    private static void assertImmutable(final AppliedConfiguration value) {
+        for (final Set<String> members : Arrays.asList(value.getVoters(), value.getLearners(), value.getOldVoters(),
+            value.getOldLearners())) {
+            try {
+                members.add(address(19000));
+                fail("Membership must be immutable");
+            } catch (final UnsupportedOperationException expected) {
+                assertFalse(members.contains(address(19000)));
+            }
+        }
+    }
+
+    private static LogEntry configuration(final long index, final long term, final boolean joint, final int basePort) {
+        final LogEntry entry = new LogEntry(EntryType.ENTRY_TYPE_CONFIGURATION);
+        entry.setId(new LogId(index, term));
+        entry.setPeers(Arrays.asList(peer(basePort)));
+        entry.setLearners(Arrays.asList(peer(basePort + 1)));
+        if (joint) {
+            entry.setOldPeers(Arrays.asList(peer(basePort + 2)));
+            entry.setOldLearners(Arrays.asList(peer(basePort + 3)));
+        }
+        return entry;
+    }
+
+    private static LogEntry noop(final long index, final long term) {
+        final LogEntry entry = new LogEntry(EntryType.ENTRY_TYPE_NO_OP);
+        entry.setId(new LogId(index, term));
+        return entry;
+    }
+
+    private static SnapshotMeta jointSnapshot(final long index, final long term, final int basePort) {
+        return SnapshotMeta.newBuilder().setLastIncludedIndex(index).setLastIncludedTerm(term)
+            .addPeers(address(basePort)).addLearners(address(basePort + 1)).addOldPeers(address(basePort + 2))
+            .addOldLearners(address(basePort + 3)).build();
+    }
+
+    private static PeerId peer(final int port) {
+        final PeerId peer = new PeerId();
+        assertTrue(peer.parse(address(port)));
+        return peer;
+    }
+
+    private static String address(final int port) {
+        return "127.0.0.1:" + port;
+    }
+}
