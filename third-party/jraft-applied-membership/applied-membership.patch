+        assertFalse(load(jointSnapshot(10, 2, 18005)).get(TIMEOUT_SECONDS, TimeUnit.SECONDS).isOk());
+        assertReadUnavailable();
+        assertEquals(2, this.fsmCaller.getLastAppliedIndex());
+        assertEquals(1, this.logManager.getFirstLogIndex());
