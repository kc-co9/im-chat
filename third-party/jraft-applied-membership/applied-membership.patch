+    @Test
+    public void testSnapshotLoadReadWaitsForRestoreAndLogManagerInstallation() throws Exception {
+        final AppliedConfiguration before = applyJointWithUncommittedStable();
+        final SnapshotMeta meta = jointSnapshot(10, 2, 18005);
+        final CompletableFuture<Status> loaded = load(meta);
+        await(this.loadEntered);
+        final CountDownLatch reading = new CountDownLatch(1);
+        final Future<AppliedConfiguration> duringLoad = this.workers.submit(() -> {
+            reading.countDown();
+            return read();
+        });
+        await(reading);
+        assertPending(duringLoad);
+        this.allowLoad.countDown();
+        await(this.installEntered);
+        // FSM has advanced its watermark, but the synchronous install closure still owns the event.
+        assertEquals(10, this.fsmCaller.getLastAppliedIndex());
+        assertEquals(1, this.logManager.getFirstLogIndex());
+        assertPending(duringLoad);
+        this.allowInstall.countDown();
+        assertTrue(loaded.get(TIMEOUT_SECONDS, TimeUnit.SECONDS).isOk());
+        assertJoint(duringLoad.get(TIMEOUT_SECONDS, TimeUnit.SECONDS), 10, 10, 18005);
+        assertEquals(11, this.logManager.getFirstLogIndex());
+        assertNull(this.logManager.getEntry(2));
+        assertJoint(read(), 10, 10, 18005);
+        assertJoint(before, 2, 2, 18001);
+        assertImmutable(before);
+    }
