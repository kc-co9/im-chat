+    @Test
+    public void testAsyncSnapshotSaveCompletionUsesSnapshotAnchorNotOriginalConfigurationIndex() throws Exception {
+        // Data-free no-ops advance application without changing the joint configuration at index 2.
+        append(configuration(1, 1, false, 18001), configuration(2, 1, true, 18001),
+            noop(3, 1), noop(4, 1), noop(5, 1));
+        assertTrue(this.fsmCaller.onCommitted(5));
+        final AppliedConfiguration before = read();
+        assertJoint(before, 5, 2, 18001);
+        final CompletableFuture<SnapshotMeta> savedMeta = new CompletableFuture<>();
+        final CompletableFuture<Status> saved = new CompletableFuture<>();
+        final SnapshotWriter writer = mock(SnapshotWriter.class);
+        assertTrue(this.fsmCaller.onSnapshotSave(new SaveSnapshotClosure() {
+            @Override
+            public SnapshotWriter start(final SnapshotMeta meta) {
+                savedMeta.complete(meta);
+                return writer;
+            }
+
+            @Override
+            public void run(final Status status) {
+                if (status.isOk()) {
+                    logManager.setSnapshot(savedMeta.join());
+                    logManager.clearBufferedLogs();
+                }
+                saved.complete(status);
+            }
+        }));
+        final Closure completion = this.pendingSave.get(TIMEOUT_SECONDS, TimeUnit.SECONDS);
+        final SnapshotMeta meta = savedMeta.get(TIMEOUT_SECONDS, TimeUnit.SECONDS);
+        assertEquals(5, meta.getLastIncludedIndex());
+        assertEquals(Collections.singletonList(address(18004)), meta.getOldLearnersList());
+        // The FSM is free while save completion is outstanding.
+        assertJoint(read(), 5, 2, 18001);
+        final CountDownLatch race = new CountDownLatch(1);
+        final Future<?> finishing = this.workers.submit(() -> {
+            await(race);
+            completion.run(Status.OK());
+        });
+        final Future<?> reading = this.workers.submit(() -> {
+            await(race);
+            for (int i = 0; i < 32; i++) {
+                final AppliedConfiguration value = read();
+                final long anchor = value.getConfigurationAnchor();
+                assertTrue("Only the original or installed snapshot anchor is valid", anchor == 2 || anchor == 5);
+                assertJoint(value, 5, anchor, 18001);
+            }
+            return null;
+        });
+        race.countDown();
+        finishing.get(TIMEOUT_SECONDS, TimeUnit.SECONDS);
+        reading.get(TIMEOUT_SECONDS, TimeUnit.SECONDS);
+        assertTrue(saved.get(TIMEOUT_SECONDS, TimeUnit.SECONDS).isOk());
+        assertEquals(6, this.logManager.getFirstLogIndex());
+        assertJoint(read(), 5, 5, 18001);
+        assertJoint(before, 5, 2, 18001);
+        assertImmutable(before);
+    }
