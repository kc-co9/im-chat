+    @Override
+    public AppliedConfiguration copyAppliedConfiguration(final long index) {
+        this.readLock.lock();
+        try {
+            if (index < this.configManager.getSnapshot().getId().getIndex()) {
+                throw new IllegalStateException("applied index precedes snapshot");
+            }
+            final ConfigurationEntry entry = this.configManager.get(index);
+            if (entry == null || entry.isEmpty() || index <= 0 || entry.getId().getIndex() > index) {
+                throw new IllegalStateException("No applied configuration");
+            }
+            return new AppliedConfiguration(index, entry);
+        } finally {
+            this.readLock.unlock();
+        }
+    }
