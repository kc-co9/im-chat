+    private static void await(final CountDownLatch latch) throws InterruptedException {
+        assertTrue("fixture barrier timed out", latch.await(5, TimeUnit.SECONDS));
+    }
+
+    private static final class ReadFixture implements AutoCloseable {
+        private final FSMCallerImpl   caller  = new FSMCallerImpl();
+        private final LogManager      logs    = mock(LogManager.class);
+        private final ExecutorService workers = Executors.newFixedThreadPool(3);
+        private final CountDownLatch  entered = new CountDownLatch(1);
+        private final CountDownLatch  release = new CountDownLatch(1);
+
+        private ReadFixture(final boolean partialApply) {
+            final NodeImpl node = mock(NodeImpl.class);
+            when(node.getNodeMetrics()).thenReturn(new NodeMetrics(false));
+            when(node.getGroupId()).thenReturn("applied-read-exits");
+            when(node.getNodeState()).thenReturn(State.STATE_FOLLOWER);
+            when(this.logs.copyAppliedConfiguration(anyLong())).thenReturn(value(1));
+            final FSMCallerOptions options = new FSMCallerOptions();
+            options.setNode(node);
+            options.setLogManager(this.logs);
+            options.setClosureQueue(new ClosureQueueImpl("applied-read-exits"));
+            options.setBootstrapId(new LogId(1, 1));
+            options.setDisruptorBufferSize(16);
+            options.setFsm(new StateMachineAdapter() {
+                @Override
+                public void onApply(final Iterator iterator) {
+                    assertTrue(partialApply);
+                    assertEquals(2, iterator.getIndex());
+                    iterator.next();
+                    assertEquals(3, iterator.getIndex());
+                    hold();
+                    iterator.setErrorAndRollback(1, new Status(RaftError.ESTATEMACHINE, "reject tail"));
+                }
+
+                @Override
+                public void onLeaderStart(final long term) {
+                    hold();
+                }
+
+                private void hold() {
+                    entered.countDown();
+                    try {
+                        await(release);
+                    } catch (final InterruptedException interrupted) {
+                        Thread.currentThread().interrupt();
+                        throw new AssertionError(interrupted);
+                    }
+                }
+            });
+            assertTrue(this.caller.init(options));
+        }
+
+        private void block() throws Exception {
+            assertTrue(this.caller.onLeaderStart(1));
+            await(this.entered);
+        }
+
+        private Future<AppliedConfiguration> read(final long timeout) {
+            return this.workers.submit(() -> this.caller.getAppliedConfiguration(timeout));
+        }
+
+        private void awaitQueued(final int count) {
+            // The blocked event retains one slot; capacity observes publication, not thread launch.
+            final long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(5);
+            while (this.caller.hasAvailableCapacity(16 - count)) {
+                assertTrue("read was not admitted", System.nanoTime() < deadline);
+                Thread.yield();
+            }
+        }
+
+        private void assertFreshReads() throws Exception {
+            // More than one ring wrap, three simultaneous readers per bounded round.
+            for (int round = 2; round <= 7; round++) {
+                final AppliedConfiguration expected = value(round);
+                final CountDownLatch copying = new CountDownLatch(1);
+                final CountDownLatch finishCopy = new CountDownLatch(1);
+                when(this.logs.copyAppliedConfiguration(anyLong())).thenAnswer(invocation -> {
+                    copying.countDown();
+                    await(finishCopy);
+                    return expected;
+                });
+                final CountDownLatch start = new CountDownLatch(1);
+                final List<Future<AppliedConfiguration>> reads = new ArrayList<>();
+                for (int reader = 0; reader < 3; reader++) {
+                    reads.add(this.workers.submit(() -> {
+                        await(start);
+                        return this.caller.getAppliedConfiguration(5000);
+                    }));
+                }
+                start.countDown();
+                try {
+                    await(copying);
+                    // One executing read plus two published reads must occupy the ring.
+                    awaitQueued(2);
+                } finally {
+                    finishCopy.countDown();
+                }
+                for (final Future<AppliedConfiguration> read : reads) {
+                    assertValue(read.get(5, TimeUnit.SECONDS), round);
+                }
+            }
+        }
+
+        @Override
+        public void close() throws Exception {
+            this.release.countDown();
+            // Resource cleanup preserves a caller termination failure and suppresses worker cleanup failures.
+            try (final AutoCloseable cleanupWorkers = () -> {
+                this.workers.shutdownNow();
+                assertTrue(this.workers.awaitTermination(5, TimeUnit.SECONDS));
+            }) {
+                final FutureTask<Void> stopped = new FutureTask<>(() -> {
+                    this.caller.shutdown();
+                    this.caller.join();
+                    return null;
+                });
+                final Thread cleanupCaller = new Thread(stopped, "applied-read-fixture-cleanup");
+                cleanupCaller.setDaemon(true);
+                cleanupCaller.start();
+                try {
+                    stopped.get(5, TimeUnit.SECONDS);
+                } finally {
+                    stopped.cancel(true);
+                }
+            }
+        }
+    }
