+
+import static org.junit.Assert.*;
+
+/** Real network/RocksDB coverage; no membership state is supplied by a mock. */
+public class AppliedConfigurationClusterTest {
+
+    private static final long                 TIMEOUT_MS          = 15000;
+    private TestCluster                       cluster;
+    private File                              dataPath;
+    private List<PeerId>                      voters;
+    private PeerId                            learner;
+    private final AtomicReference<StableGate> stableGate          = new AtomicReference<>();
+    private final AtomicLong                  firstCompactedIndex = new AtomicLong();
+
+    @Before
+    public void setup() throws Exception {
+        this.dataPath = Files.createTempDirectory("jraft-applied-cluster-").toFile();
+        final List<PeerId> peers = freePeers(4);
+        this.voters = new ArrayList<>(peers.subList(0, 3));
+        this.learner = peers.get(3);
+        this.cluster = new TestCluster("applied-" + this.dataPath.getName(), this.dataPath.getPath(), this.voters,
+            new LinkedHashSet<>(Collections.singletonList(this.learner)), 3000);
+        this.cluster.setRaftServiceFactory(new TestJRaftServiceFactory() {
+            @Override
+            public LogStorage createLogStorage(final String uri, final RaftOptions options) {
+                return new RocksDBLogStorage(uri, options) {
+                    @Override
+                    public int appendEntries(final List<LogEntry> entries) {
+                        final StableGate gate = stableGate.get();
+                        if (gate != null) {
+                            gate.beforeAppend(entries);
+                        }
+                        return super.appendEntries(entries);
+                    }
+
+                    @Override
+                    public boolean truncatePrefix(final long firstIndexKept) {
+                        final boolean truncated = super.truncatePrefix(firstIndexKept);
+                        if (truncated) {
+                            firstCompactedIndex.accumulateAndGet(firstIndexKept, Math::max);
+                        }
+                        return truncated;
+                    }
+                };
+            }
+        });
+        for (final PeerId peer : peers) {
+            assertTrue(this.cluster.start(peer.getEndpoint(), false, 0));
+        }
+        await("leader election", () -> this.cluster.getLeader() != null);
+        apply(this.cluster.getLeader(), 1);
+        assertAllStable(this.voters, Collections.singletonList(this.learner));
+    }
+
+    @After
+    public void teardown() throws Exception {
+        final StableGate gate = this.stableGate.getAndSet(null);
+        if (gate != null) {
+            gate.release.countDown();
+        }
+        try {
+            if (this.cluster != null) {
+                this.cluster.stopAll();
+            }
+        } finally {
+            if (this.dataPath != null) {
+                FileUtils.deleteDirectory(this.dataPath);
+            }
+        }
+    }
+
+    @Test(timeout = 90000)
+    public void testFollowerAndLearnerFullStableMembershipAndImmutableResult() throws Exception {
+        assertEquals(2, this.cluster.getFollowers().size());
+        final AppliedConfiguration follower = read(this.cluster.getFollowers().get(0));
+        final AppliedConfiguration learning = read(node(this.learner));
+        assertStable(follower, this.voters, Collections.singletonList(this.learner));
+        assertStable(learning, this.voters, Collections.singletonList(this.learner));
+        assertImmutable(follower.getVoters());
+        assertImmutable(follower.getLearners());
+        assertImmutable(follower.getOldVoters());
+        assertImmutable(follower.getOldLearners());
+    }
+
+    @Test(timeout = 90000)
+    public void testAddAndRemoveLearnerKeepsPreviousAppliedSnapshot() throws Exception {
+        final Node leader = this.cluster.getLeader();
+        final AppliedConfiguration before = read(node(this.learner));
+        final PeerId added = freePeers(1).get(0);
+        assertTrue(this.cluster.startLearner(added));
+        final Completion add = new Completion();
+        leader.addLearners(Collections.singletonList(added), add);
+        add.assertOk();
+        assertAllStable(this.voters, Arrays.asList(this.learner, added));
+        final AppliedConfiguration withAdded = read(node(added));
+        final Completion remove = new Completion();
+        leader.removeLearners(Collections.singletonList(added), remove);
+        remove.assertOk();
+        // A removed learner need not receive the removal; inspect the surviving real nodes.
+        assertTrue(this.cluster.stop(added.getEndpoint()));
+        this.cluster.getLearners().remove(added);
+        assertAllStable(this.voters, Collections.singletonList(this.learner));
+        assertStable(before, this.voters, Collections.singletonList(this.learner));
+        assertStable(withAdded, this.voters, Arrays.asList(this.learner, added));
+        assertTrue(withAdded.getConfigurationAnchor() > before.getConfigurationAnchor());
+    }
+
+    @Test(timeout = 120000)
+    public void testRealDemotionAndPromotionJointToStable() throws Exception {
+        final Node leader = this.cluster.getLeader();
+        final PeerId demoted = this.cluster.getFollowers().get(0).getNodeId().getPeerId();
+        final List<PeerId> twoVoters = new ArrayList<>(this.voters);
+        twoVoters.remove(demoted);
+        final List<PeerId> twoLearners = Arrays.asList(this.learner, demoted);
+        // Match BrokerRaftAdapter: remove voter, then add learner. Cross-role changes
+        // in one entry are rejected because joint voters and learners intersect.
+        final AppliedConfiguration demotion = changeThroughJoint(leader, this.voters, twoVoters,
+            Collections.singletonList(this.learner));
+        final Completion addLearner = new Completion();
+        leader.addLearners(Collections.singletonList(demoted), addLearner);
+        addLearner.assertOk();
+        assertAllStable(twoVoters, twoLearners);
+        // Promotion likewise removes the learner before adding the voter.
+        final Completion removeLearner = new Completion();
+        leader.removeLearners(Collections.singletonList(demoted), removeLearner);
+        removeLearner.assertOk();
+        assertAllStable(twoVoters, Collections.singletonList(this.learner));
+        final AppliedConfiguration promotion = changeThroughJoint(leader, twoVoters, this.voters,
+            Collections.singletonList(this.learner));
+        // Held results must not become stable or change when subsequent entries apply.
+        assertFalse(demotion.isStable());
+        assertEquals(values(twoVoters), demotion.getVoters());
+        assertEquals(values(this.voters), demotion.getOldVoters());
+        assertEquals(values(Collections.singletonList(this.learner)), demotion.getLearners());
+        assertFalse(promotion.isStable());
+        assertEquals(values(twoVoters), promotion.getOldVoters());
+        assertTrue(promotion.getConfigurationAnchor() > demotion.getConfigurationAnchor());
+        assertAllStable(this.voters, Collections.singletonList(this.learner));
+    }
+
+    @Test(timeout = 120000)
+    public void testLaggingFollowerInstallsSnapshotAndRestartRecoversMembership() throws Exception {
+        final Node leader = this.cluster.getLeader();
+        final PeerId lagging = this.cluster.getFollowers().get(0).getNodeId().getPeerId();
+        assertTrue(this.cluster.stop(lagging.getEndpoint()));
+        apply(leader, 20);
+        snapshot(leader);
+        final AppliedConfiguration saved = read(leader);
+        apply(leader, 20);
+        snapshot(leader);
+        await("persisted leader prefix compaction", () -> this.firstCompactedIndex.get() > saved.getAppliedIndex());
+        // Empty local storage cannot obtain the compacted prefix via AppendEntries.
+        this.cluster.clean(lagging.getEndpoint());
+        assertTrue(this.cluster.start(lagging.getEndpoint(), true, 0));
+        await("real follower snapshot load", () -> this.cluster.getFsmByPeer(lagging).getLoadSnapshotTimes() > 0);
+        final AppliedConfiguration installed = awaitStable(node(lagging), this.voters,
+            Collections.singletonList(this.learner));
+        assertTrue(installed.getConfigurationAnchor() >= saved.getAppliedIndex());
+        assertTrue(installed.getAppliedIndex() >= installed.getConfigurationAnchor());
+        assertTrue(this.cluster.ensureSame(1500));
+        snapshot(node(lagging));
+        assertTrue(this.cluster.stop(lagging.getEndpoint()));
+        // Keep disk state; no bootstrap configuration is provided on restart.
+        assertTrue(this.cluster.start(lagging.getEndpoint(), true, 0));
+        await("restart snapshot recovery", () -> this.cluster.getFsmByPeer(lagging).getLoadSnapshotTimes() > 0);
+        final AppliedConfiguration recovered = awaitStable(node(lagging), this.voters,
+            Collections.singletonList(this.learner));
+        assertTrue(recovered.getConfigurationAnchor() >= installed.getConfigurationAnchor());
+        assertStable(installed, this.voters, Collections.singletonList(this.learner));
+    }
+
+    private AppliedConfiguration changeThroughJoint(final Node leader, final List<PeerId> oldVoters,
+                                                    final List<PeerId> newVoters, final List<PeerId> newLearners)
+                                                                                                                 throws Exception {
+        final StableGate gate = new StableGate(newVoters, newLearners);
+        this.stableGate.set(gate);
+        final Completion changed = new Completion();
+        leader.changePeers(new Configuration(newVoters, newLearners), changed);
+        AppliedConfiguration captured;
+        try {
+            assertTrue("stable append did not reach the storage barrier",
+                gate.entered.await(TIMEOUT_MS, TimeUnit.MILLISECONDS));
+            // Stable is already in LogManager but cannot commit: all real disks hold its append.
+            // The accessor must resolve by applied watermark, not latest-seen configuration.
+            captured = awaitJoint(node(this.learner), oldVoters, newVoters, newLearners);
+            for (final PeerId voter : oldVoters) {
+                if (!voter.equals(leader.getNodeId().getPeerId())) {
+                    awaitJoint(node(voter), oldVoters, newVoters, newLearners);
+                }
+            }
+            assertNull("stable change completed while stable persistence was held", changed.status.get());
+        } finally {
+            gate.release.countDown();
+            this.stableGate.compareAndSet(gate, null);
+        }
+        changed.assertOk();
+        assertAllStable(newVoters, newLearners);
+        return captured;
+    }
+
+    private AppliedConfiguration awaitJoint(final Node node, final List<PeerId> oldVoters,
+                                            final List<PeerId> newVoters, final List<PeerId> newLearners)
+                                                                                                     throws Exception {
+        final AtomicReference<AppliedConfiguration> result = new AtomicReference<>();
+        await("joint applied on " + node.getNodeId(), () -> {
+            final AppliedConfiguration value = read(node);
+            if (value.isStable() || !value.getVoters().equals(values(newVoters))) {
+                return false;
+            }
+            assertEquals(values(oldVoters), value.getOldVoters());
+            assertEquals(values(newLearners), value.getLearners());
+            // Upstream ConfigurationCtx.nextStage builds oldConf from oldPeers only.
+            // Do not fabricate old learners omitted by the actual upstream log entry.
+            assertTrue(value.getOldLearners().isEmpty());
+            assertTrue(value.getConfigurationAnchor() > 0);
+            assertTrue(value.getAppliedIndex() >= value.getConfigurationAnchor());
+            result.set(value);
+            return true;
+        });
+        return result.get();
+    }
+
+    private void assertAllStable(final List<PeerId> peers, final List<PeerId> learners) throws Exception {
+        for (final Node node : this.cluster.getNodes()) {
+            final PeerId peer = node.getNodeId().getPeerId();
+            // Removed members have no obligation to receive their removal entry.
+            if (peers.contains(peer) || learners.contains(peer)) {
+                awaitStable(node, peers, learners);
+            }
+        }
+    }
+
+    private static AppliedConfiguration awaitStable(final Node node, final List<PeerId> peers,
+                                                     final List<PeerId> learners) throws Exception {
+        final AtomicReference<AppliedConfiguration> result = new AtomicReference<>();
+        await("stable membership on " + node.getNodeId(), () -> {
+            final AppliedConfiguration value;
+            try {
+                value = read(node);
+            } catch (final IllegalStateException unavailableBeforeFirstApply) {
+                return false;
+            }
+            if (!value.isStable() || !value.getVoters().equals(values(peers))
+                || !value.getLearners().equals(values(learners))) {
+                return false;
+            }
+            assertStable(value, peers, learners);
+            result.set(value);
+            return true;
+        });
+        return result.get();
+    }
+
+    private static AppliedConfiguration read(final Node node) throws Exception {
+        return node.getAppliedConfiguration(2000);
+    }
+
+    private static void assertStable(final AppliedConfiguration value, final List<PeerId> peers,
+                                     final List<PeerId> learners) {
+        assertTrue(value.isStable());
+        assertEquals(values(peers), value.getVoters());
+        assertEquals(values(learners), value.getLearners());
+        assertTrue(value.getOldVoters().isEmpty());
+        assertTrue(value.getOldLearners().isEmpty());
+        assertTrue("bootstrap index zero is not applied evidence", value.getAppliedIndex() > 0);
+        assertTrue(value.getConfigurationAnchor() > 0);
+        assertTrue(value.getConfigurationAnchor() <= value.getAppliedIndex());
+    }
+
+    private Node node(final PeerId peer) {
+        for (final Node node : this.cluster.getNodes()) {
+            if (node.getNodeId().getPeerId().equals(peer)) {
+                return node;
+            }
+        }
+        throw new AssertionError("No running node for " + peer);
+    }
+
+    private static void apply(final Node leader, final int count) throws Exception {
+        final Completion done = new Completion(count);
+        for (int i = 0; i < count; i++) {
+            leader.apply(new Task(ByteBuffer.wrap(new byte[] { (byte) i }), done));
+        }
+        done.assertOk();
+    }
+
+    private static void snapshot(final Node node) throws Exception {
+        final Completion done = new Completion();
+        node.snapshot(done);
+        done.assertOk();
+    }
+
+    private static Set<String> values(final Iterable<PeerId> peers) {
+        final Set<String> values = new LinkedHashSet<>();
+        for (final PeerId peer : peers) {
+            values.add(peer.toString());
+        }
+        return values;
+    }
+
+    private static void assertImmutable(final Set<String> values) {
+        try {
+            values.add("127.0.0.1:1");
+            fail("membership set is mutable");
+        } catch (final UnsupportedOperationException expected) {
+            // expected
+        }
+    }
+
+    // Hold all reservations until allocation finishes, avoiding duplicate ephemeral ports.
+    private static List<PeerId> freePeers(final int count) throws Exception {
+        final List<ServerSocket> reservations = new ArrayList<>();
+        final List<PeerId> peers = new ArrayList<>();
+        try {
+            for (int i = 0; i < count; i++) {
+                final ServerSocket reservation = new ServerSocket(0);
+                reservations.add(reservation);
+                peers.add(new PeerId("127.0.0.1", reservation.getLocalPort()));
+            }
+            return peers;
+        } finally {
+            for (final ServerSocket reservation : reservations) {
+                reservation.close();
+            }
+        }
+    }
+
+    private interface Condition {
+        boolean evaluate() throws Exception;
+    }
+
+    // Bounded observation polling, never a delay used to create a race or transition.
+    private static void await(final String description, final Condition condition) throws Exception {
+        final long deadline = System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(TIMEOUT_MS);
+        do {
+            if (condition.evaluate()) {
+                return;
+            }
+            Thread.sleep(10);
+        } while (System.nanoTime() < deadline);
+        fail("Timed out waiting for " + description);
+    }
+
+    private static final class Completion implements Closure {
+        private final CountDownLatch          latch;
+        private final AtomicReference<Status> status = new AtomicReference<>();
+        private final AtomicReference<Status> error  = new AtomicReference<>();
+
+        private Completion() {
+            this(1);
+        }
+
+        private Completion(final int count) {
+            this.latch = new CountDownLatch(count);
+        }
+
+        @Override
+        public void run(final Status value) {
+            this.status.set(value);
+            if (!value.isOk()) {
+                this.error.compareAndSet(null, value);
+            }
+            this.latch.countDown();
+        }
+
+        private void assertOk() throws Exception {
+            assertTrue("raft operation did not complete", this.latch.await(TIMEOUT_MS, TimeUnit.MILLISECONDS));
+            assertNull("raft operation failed: " + this.error.get(), this.error.get());
+            assertNotNull(this.status.get());
+        }
+    }
+
+    /** Delay only actual stable persistence; joint/data entries still use real RocksDB. */
+    private static final class StableGate {
+        private final Set<String>    voters;
+        private final Set<String>    learners;
+        private final CountDownLatch entered = new CountDownLatch(1);
+        private final CountDownLatch release = new CountDownLatch(1);
+
+        private StableGate(final List<PeerId> voters, final List<PeerId> learners) {
+            this.voters = values(voters);
+            this.learners = values(learners);
+        }
+
+        private void beforeAppend(final List<LogEntry> entries) {
+            for (final LogEntry entry : entries) {
+                if (entry.getType() == EntryType.ENTRY_TYPE_CONFIGURATION
+                    && (entry.getOldPeers() == null || entry.getOldPeers().isEmpty())
+                    && values(entry.getPeers()).equals(this.voters)
+                    && values(entry.getLearners() == null ? Collections.<PeerId> emptyList() : entry.getLearners())
+                        .equals(this.learners)) {
+                    this.entered.countDown();
+                    try {
+                        if (!this.release.await(30, TimeUnit.SECONDS)) {
+                            throw new AssertionError("stable persistence barrier was not released");
+                        }
+                    } catch (final InterruptedException interrupted) {
+                        Thread.currentThread().interrupt();
+                        throw new AssertionError(interrupted);
+                    }
+                }
+            }
+        }
+    }
+}
