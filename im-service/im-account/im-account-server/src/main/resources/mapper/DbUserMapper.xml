<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.co.kc.imchat.service.account.infrastructure.mybatis.mapper.DbUserMapper">
    <select id="selectRawUsers"
            resultType="com.co.kc.imchat.service.account.infrastructure.mybatis.entity.DbUser">
        <bind name="userId" value="condition.userId.orElse(null)"/>
        <bind name="username" value="condition.username.orElse(null)"/>
        <bind name="email" value="condition.email.orElse(null)"/>
        <bind name="status" value="condition.status.orElse(null)"/>
        SELECT `id`,
               `user_id`,
               `username`,
               `email`,
               `password`,
               `status`,
               `create_time`,
               `update_time`,
               `is_deleted`
        FROM `db_user`
        <where>
            <if test="userId != null">
                AND `user_id` = #{userId}
            </if>
            <if test="username != null and username != ''">
                AND `username` LIKE CONCAT('%', #{username}, '%')
            </if>
            <if test="email != null and email != ''">
                AND `email` = #{email}
            </if>
            <if test="status != null">
                AND `status` = #{status}
            </if>
        </where>
        ORDER BY `user_id` DESC
    </select>

    <select id="selectRawByUserId"
            resultType="com.co.kc.imchat.service.account.infrastructure.mybatis.entity.DbUser">
        SELECT `id`,
               `user_id`,
               `username`,
               `email`,
               `password`,
               `status`,
               `create_time`,
               `update_time`,
               `is_deleted`
        FROM `db_user`
        WHERE `user_id` = #{userId}
        LIMIT 1
    </select>
</mapper>
