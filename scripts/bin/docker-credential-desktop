#!/bin/sh
# 仅固定受审 Docker Desktop 凭据助手来源；参数原样转发，不读取或记录凭据。
set -eu
PATH=/usr/bin:/bin
export PATH
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd -P)
exec /usr/bin/ruby -e '
root = File.realpath(ARGV.shift)
require File.join(root, "scripts/lib/harness-reactor-evidence")
exec ReactorEvidence.new(root).approved_local_tool("docker-credential-desktop"), *ARGV
' "$root" "$@"
